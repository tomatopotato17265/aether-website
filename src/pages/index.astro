---
import { getImage } from 'astro:assets';
import Home from '../components/svelte/Home.svelte';
import appScreenshot from '../assets/hero.png';
import appleIcon from '../assets/apple.svg?url';
import linuxIcon from '../assets/linux.svg?url';
import windowsIcon from '../assets/windows.svg?url';
import logo from '../assets/logo.png';
import '../styles/custom.css';

const optimizedHero = await getImage({ src: appScreenshot, width: 1000 });
const ogImageUrl = new URL(logo.src, Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="A minimal, extensible, lightning-fast Minecraft launcher" />
		<link rel="icon" type="image/png" href={logo.src} />
		<title>Aether</title>

		<meta property="og:title" content="Aether" />
		<meta property="og:description" content="A minimal, extensible, lightning-fast Minecraft launcher" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<Home
			heroSrc={optimizedHero.src}
			heroWidth={optimizedHero.attributes.width}
			heroHeight={optimizedHero.attributes.height}
			appleIcon={appleIcon}
			linuxIcon={linuxIcon}
			windowsIcon={windowsIcon}
			client:load
		/>
	</body>
</html>
